generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

//enum Category {
//  ACADEMIC
//  DORM
//  SOCIAL
//  GENERAL
//}

enum PostCategory{
    CONFESSIONS
    TEA
    WISH
    NEEDADVICE
}

enum MessageStatus {
  PENDING
  APPROVED
  REJECTED
}


enum Role{
    ADMIN
    USER
} //changes admin and student

